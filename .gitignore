# --- ESP-IDF build output ---
firmware/esp32-s3-cam/build/
firmware/esp32-s3-cam/build_*/
firmware/esp32-s3-cam/sdkconfig
firmware/esp32-s3-cam/sdkconfig.old
firmware/esp32-s3-cam/managed_components/

# dependencies.lock IS committed on purpose: it pins the exact managed
# component versions that were verified working on the hardware.

# --- Thin OTA server artifacts (generated by publish.sh, never committed) ---
# The whole firmware/ tree: published images plus logs and experiment captures from
# OTA runs. None of it is source, and the server exposes whatever is in here.
tools/ota-server/manifest.json
tools/ota-server/firmware/
tools/ota-server/__pycache__/

# --- Parking vision (P0002): generated artifacts ---
vision/data/debug/
vision/data/reference/
# The emitted P0002 contract: generated from the config by src/emit_map.py and by
# src/main.py while it runs. The config is the source of truth, so a committed copy of
# the contract could only go stale.
vision/out/
vision/data/cases/*.csv
vision/__pycache__/
vision/src/__pycache__/
vision/tests/__pycache__/

# Kept in git on purpose:
#   vision/config/parking_spots.json   - the calibration itself, it is work
#   vision/data/cases/labels.json      - hand-written ground truth for the cases

# --- start.sh 的运行产物（pid 文件 + 日志）---
run/

# --- Python bytecode, anywhere (the per-directory entries above missed tools/) ---
__pycache__/
*.pyc

# --- macOS ---
.DS_Store

# The global exclude file on this machine contains bare "docs" and ".gitignore"
# patterns, which ignore them in every repository - including this one, silently, so
# docs/architecture.md (the system-boundary document the README points at) and this
# very file were never committed. Re-including beats remembering.
!docs/
!docs/**
!.gitignore

# Hand-labelled HOG dataset: regenerable from the labeller, and it is annotation data rather than
# source. The model it produces (vision/data/hero_hog.yml) stays tracked, because that is what the
# detector loads.
tools/hero_lab/data/

# Magnetometer calibration samples and their frames: per-installation measurement, not source.
vision/data/hsv_marker/calibration.jsonl
vision/data/hsv_marker/calibration.recovered.jsonl
vision/data/hsv_marker/frames/
